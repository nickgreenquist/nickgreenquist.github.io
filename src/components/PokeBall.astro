---
// The Poke Ball from the TCG binder and MissingNo.Zero posts, as an inline icon.
// Brand-fixed colors (not themed); the black outline keeps it legible in dark mode.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class={className}>
  <defs><clipPath id="pokeball-icon-clip"><circle cx="50" cy="50" r="46" /></clipPath></defs>
  <g clip-path="url(#pokeball-icon-clip)">
    <rect x="0" y="0" width="100" height="50" fill="#ee1515" />
    <rect x="0" y="50" width="100" height="50" fill="#f6f6f6" />
    <rect x="0" y="44" width="100" height="12" fill="#1b1b1b" />
  </g>
  <circle cx="50" cy="50" r="46" fill="none" stroke="#1b1b1b" stroke-width="6" />
  <circle cx="50" cy="50" r="15" fill="#f6f6f6" stroke="#1b1b1b" stroke-width="6" />
  <circle cx="50" cy="50" r="6" fill="#f6f6f6" stroke="#1b1b1b" stroke-width="3" />
</svg>
